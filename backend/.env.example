SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=pk_...
SUPABASE_SERVICE_ROLE_KEY=sk_...    # server-only, never expose to client
OPENAI_API_KEY=sk-...               # or LLM provider key
NODE_ENV=development
PORT=5000

# Firebase Admin (for verifying Firebase ID tokens from Phone Auth)
# Provide either these three or use GOOGLE_APPLICATION_CREDENTIALS path to a JSON key file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
